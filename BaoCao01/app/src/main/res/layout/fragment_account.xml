<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:weightSum="15">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:background="@drawable/bgnotifi">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin tài khoản"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="32sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:layout_gravity="center">
        </TextView>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="13.9"
        android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingTop= "10dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/anhKH"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            app:shapeAppearanceOverlay="@style/AvatarStyle" />
                        <TextView
                            android:id="@+id/tenKH"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="10dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="32sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center_vertical"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#000000" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:layout_marginTop="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Địa chỉ"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/diachi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_medium"
                            android:gravity="right"
                            android:maxLines="1"
                            android:textColor="@color/colortext"
                            android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Số điện thoại"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/sdt"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Email"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/email"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Ngày sinh"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/ngaysinh"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="08-08-2003"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Ngày đăng kí"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/ngaydk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="08-08-2003"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Hạng thành viên"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/hang"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="right"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:weightSum="2"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Điểm tích lũy"
                            android:fontFamily="@font/montserrat_bold"
                            android:textSize="18sp"
                            android:textColor="@color/black"/>
                        <TextView
                            android:id="@+id/diem"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="right"
                            android:fontFamily="@font/montserrat_medium"
                            android:textSize="18sp"
                            android:textColor="@color/colortext"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin khác"
                        android:fontFamily="@font/montserrat_bold"
                        android:textSize="28sp"
                        android:textAlignment="center"
                        android:textColor="@color/black"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:orientation="vertical">
                        <FrameLayout
                            android:id="@+id/orderHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bgctkh">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="40dp"
                                android:text="Lịch sử đặt hàng"
                                android:textSize="24sp"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/white"/>
                            <ImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="end"
                                android:layout_marginEnd="25dp"
                                android:src="@drawable/iconshoppingcart"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/buyHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bgctkh">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="40dp"
                                android:text="Lịch sử mua hàng"
                                android:textSize="24sp"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/white"/>
                            <ImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="end"
                                android:layout_marginEnd="25dp"
                                android:src="@drawable/icon_ordersuccessed"/>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bgctkh">
                            <TextView
                                android:id="@+id/updateInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="40dp"
                                android:text="Thay đổi thông tin"
                                android:textSize="24sp"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/white"/>
                            <ImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="end"
                                android:layout_marginEnd="25dp"
                                android:src="@drawable/icon_info"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/logoutBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bgctkh">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:text="Đăng xuất"
                                android:textSize="24sp"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/white"/>
                            <ImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="end"
                                android:layout_marginEnd="25dp"
                                android:src="@drawable/icon_log_out"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
    </LinearLayout>
</LinearLayout>