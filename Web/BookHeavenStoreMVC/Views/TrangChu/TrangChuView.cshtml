<script type="module" src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var chart = document.getElementById('chart').getContext('2d');
        var doanhThuTheoNam = @Html.Raw(JsonConvert.SerializeObject(ViewBag.DoanhThuTrongNam));
        if (doanhThuTheoNam && doanhThuTheoNam.length > 0) {
            var labels = doanhThuTheoNam.map(function (item) {
                return item.month + '/' + item.year;
            });
            var data = doanhThuTheoNam.map(function (item) {
                return item.total;
            });

            console.log(doanhThuTheoNam); console.log('Labels:', labels);
            console.log('Data:', data);

            var chartt = new Chart(chart, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: data,
                        backgroundColor: 'rgba(0, 119, 204, 0.3)',
                        borderColor: 'rgba(0, 119, 204, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        } else {
            console.log("Dữ liệu doanh thu không hợp lệ hoặc rỗng.");
        }
    });
</script>
